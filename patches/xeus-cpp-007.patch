 src/xinterpreter.cpp              |  4 ++--
 src/xmagics/multi_interpreter.cpp |  4 ++--
 src/xmagics/multi_interpreter.hpp |  2 +-
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/src/xinspect.cpp b/src/xinspect.cpp
index 1ec4571..bccd032 100644
--- a/src/xinspect.cpp
+++ b/src/xinspect.cpp
@@ -70,9 +70,9 @@ namespace xcpp
         {
             static unsigned long long var_count = 0;
 
-            if (auto* type = Cpp::GetType(expression))
+            if (auto type = Cpp::GetType(expression))
             {
-                return Cpp::GetQualifiedName(type);
+                return Cpp::GetTypeAsString(type);
             }
 
             std::string id = "__Xeus_GetType_" + std::to_string(var_count++);
@@ -80,9 +80,9 @@ namespace xcpp
 
             if (!Cpp::Declare(using_clause.c_str(), false))
             {
-                Cpp::TCppScope_t lookup = Cpp::GetNamed(id, nullptr);
-                Cpp::TCppType_t lookup_ty = Cpp::GetTypeFromScope(lookup);
-                return Cpp::GetQualifiedCompleteName(Cpp::GetCanonicalType(lookup_ty));
+                Cpp::DeclRef lookup = Cpp::GetNamed(id, nullptr);
+                Cpp::TypeRef lookup_ty = Cpp::GetTypeFromScope(lookup);
+                return Cpp::GetTypeAsString(Cpp::GetCanonicalType(lookup_ty));
             }
             return "";
         }
